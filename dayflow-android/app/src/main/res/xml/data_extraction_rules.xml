<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Never transfer encrypted Gemini credentials without their device-bound Keystore key. -->
        <exclude domain="sharedpref" path="dayflow_gemini_secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="dayflow_gemini_secrets.xml" />
    </device-transfer>
</data-extraction-rules>
