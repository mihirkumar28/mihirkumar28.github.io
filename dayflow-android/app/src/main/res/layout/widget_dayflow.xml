<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="6dp"
    android:paddingTop="3dp"
    android:paddingRight="6dp"
    android:paddingBottom="3dp"
    android:background="#F4F6F1">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:text="WFH"
            android:textColor="#18372E"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_task"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:text="Current task"
            android:textColor="#18372E"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/widget_timing"
                android:layout_width="38dp"
                android:layout_height="wrap_content"
                android:text="ENDS IN"
                android:textColor="#687A70"
                android:textSize="7sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
            <Chronometer
                android:id="@+id/widget_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:countDown="true"
                android:format="%s"
                android:text="00:00"
                android:textColor="#18372E"
                android:textSize="9sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/widget_metrics_label"
                android:layout_width="34dp"
                android:layout_height="wrap_content"
                android:text="PLAN"
                android:textColor="#687A70"
                android:textSize="7sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
            <Chronometer
                android:id="@+id/widget_metrics"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:format="%s"
                android:text="0/0 • S —%"
                android:textColor="#496257"
                android:textSize="8sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_screen_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:text="SCREEN • Collecting"
            android:textColor="#687A70"
            android:textSize="8sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_controls"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_action"
            android:layout_width="match_parent"
            android:layout_height="25dp"
            android:gravity="center"
            android:text="IN"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:background="#286B55"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_commute"
            android:layout_width="match_parent"
            android:layout_height="25dp"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="START"
            android:textColor="#18372E"
            android:textSize="8sp"
            android:textStyle="bold"
            android:background="#E6EEE7"
            android:includeFontPadding="false" />
    </LinearLayout>
</LinearLayout>
