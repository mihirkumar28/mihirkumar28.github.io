<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="top"
    android:background="@android:color/transparent">

    <!-- The outer widget may occupy two launcher rows, but the visible card wraps its content. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="10dp"
        android:paddingTop="6dp"
        android:paddingRight="10dp"
        android:paddingBottom="6dp"
        android:background="@drawable/widget_card_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="125dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingLeft="6dp"
            android:paddingTop="3dp"
            android:paddingRight="6dp"
            android:paddingBottom="3dp"
            android:includeFontPadding="false"
            android:text="WFH"
            android:textColor="#285A43"
            android:textSize="8sp"
            android:textStyle="bold"
            android:background="@drawable/widget_status_badge" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/widget_timing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:text="ENDS IN"
            android:textColor="#687A70"
            android:textSize="7sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <Chronometer
            android:id="@+id/widget_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:countDown="true"
            android:format="%s"
            android:text="00:00"
            android:textColor="#18372E"
            android:textSize="10sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:includeFontPadding="false" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_task"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:text="Current task"
        android:textColor="#18372E"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:background="#DCE6DE"
        android:orientation="horizontal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_metric_1_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OFFICE"
                android:textColor="#687A70"
                android:textSize="7sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <Chronometer
                android:id="@+id/widget_metric_1_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:format="%s"
                android:text="0m"
                android:textColor="#18372E"
                android:textSize="10sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="1dp"
            android:layout_height="25dp"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:background="#DCE6DE"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_metric_2_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="COMMUTE"
                android:textColor="#687A70"
                android:textSize="7sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <Chronometer
                android:id="@+id/widget_metric_2_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:format="%s"
                android:text="0m"
                android:textColor="#18372E"
                android:textSize="10sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="1dp"
            android:layout_height="25dp"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:background="#DCE6DE"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_metric_3_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SCREEN"
                android:textColor="#687A70"
                android:textSize="7sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_metric_3_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:text="Collecting"
                android:textColor="#18372E"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_action"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Check in"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:background="@drawable/widget_action_primary"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_commute"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Start commute"
            android:textColor="#18372E"
            android:textSize="9sp"
            android:textStyle="bold"
            android:background="@drawable/widget_action_secondary"
            android:includeFontPadding="false" />
    </LinearLayout>
    </LinearLayout>
</LinearLayout>
